{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trade Calendar",
  "version": "0.1.0",
  "identifier": "cat.pau.tradecalendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Trade Calendar", "width": 1440, "height": 920, "minWidth": 1100, "minHeight": 700 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/captures/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
